# ─────────────────────────────────────────────────────────────
#  ตัวอย่างไฟล์กำหนดค่า  Copy ไฟล์นี้เป็น .env แล้วแก้ไขค่า
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ── Admin credentials ───────────────────────────────────────
# ชื่อผู้ใช้แอดมิน (ค่าเริ่มต้น: admin)
ADMIN_USER=admin
# รหัสผ่านแอดมินแบบ plain text (ค่าเริ่มต้น: admin123)
# ระบบจะ hash ด้วย bcrypt อัตโนมัติเมื่อเริ่ม server
ADMIN_PASSWORD=admin123
# (ไม่บังคับ) ถ้าต้องการเก็บเป็น bcrypt hash สร้างด้วย:
#   node -e "console.log(require('bcryptjs').hashSync('yourpass',10))"
# ADMIN_PASSWORD_HASH=$2a$10$...

# ── Email (Nodemailer SMTP) ─────────────────────────────────
# ถ้าไม่กรอกค่าเหล่านี้ แอปจะยังทำงานได้ปกติ แต่จะไม่ส่งอีเมลแจ้งเตือน
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# สำหรับ Gmail: ใช้ App Password ไม่ใช่รหัสผ่านปกติ
# ดูวิธีสร้างได้ใน README.md
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Cyber Report <your-email@gmail.com>"
# อีเมลที่จะรับการแจ้งเตือนเมื่อมีรายงานใหม่
NOTIFY_EMAIL=triwit766@gmail.com
