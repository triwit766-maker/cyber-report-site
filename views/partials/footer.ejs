        </span>
        <span class="name"><%= ORG.name %></span>
      </div>
      <p><%= ORG.tagline %></p>
      <p>อีเมล: <a href="mailto:<%= ORG.contactEmail %>" style="display:inline"><%= ORG.contactEmail %></a></p>
      <p>โทร: <%= ORG.contactPhone %></p>
