<%- include('partials/header', { title: 'หน้าแรก' }) %>

<section class="hero">
  <span class="eyebrow"><%= ORG.short %> · Official Incident Reporting Portal</span>
  <h1>แจ้งปัญหาความมั่นคงปลอดภัยไซเบอร์<br>ได้อย่างรวดเร็ว ปลอดภัย และโปร่งใส</h1>
  <p><%= ORG.tagline %> — พบมัลแวร์ อีเมลฟิชชิ่ง บัญชีถูกฮัก ข้อมูลรั่วไหล หรือเว็บถูกโจมตี DDoS? แจ้งเหตุให้ทีมความปลอดภัยทราบผ่านช่องทางทางการนี้ ระบบจะออกรหัสติดตามให้คุณทันที</p>
  <div class="hero-cta">
    <a href="/report" class="btn btn-primary">แจ้งปัญหาใหม่</a>
    <a href="/track" class="btn btn-ghost">ติดตามรายงานด้วยรหัส</a>
    <a href="/reports" class="btn btn-ghost">ดูรายการที่แจ้ง</a>
  </div>
</section>

<div class="container">
  <!-- Live trust stats pulled from DB -->
  <div class="stats-strip">
    <div class="stat"><div class="num"><%= stats.total %></div><div class="lbl">รายงานที่ได้รับทั้งหมด</div></div>
    <div class="stat"><div class="num c-amber"><%= stats.pending %></div><div class="lbl">รอดำเนินการ</div></div>
    <div class="stat"><div class="num c-steel"><%= stats.in_progress %></div><div class="lbl">กำลังดำเนินการ</div></div>
    <div class="stat"><div class="num c-emerald"><%= stats.resolved %></div><div class="lbl">ดำเนินการแก้ไขแล้ว</div></div>
    <div class="stat"><div class="num c-emerald"><%= stats.resolution_rate %>%</div><div class="lbl">อัตราการแก้ไข</div></div>
  </div>

  <div class="features">
    <div class="feature-card">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <h3>ความเป็นส่วนตัว</h3>
      <p>ชื่อและช่องทางติดต่อของผู้แจ้งจะไม่แสดงต่อสาธารณะ เห็นได้เฉพาะผู้ดูแลระบบที่ผ่านการยืนยันตัวตนเท่านั้น</p>
    </div>
    <div class="feature-card">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
      </div>
      <h3>รหัสติดตามรายงาน</h3>
      <p>หลังแจ้งเหตุ คุณจะได้รับรหัส Ticket ID (เช่น CR-2026-XXXXXX) ใช้ติดตามสถานะการดำเนินการได้ทุกเวลาโดยไม่ต้องเข้าสู่ระบบ</p>
    </div>
    <div class="feature-card">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <h3>ติดตามสถานะแบบโปร่งใส</h3>
      <p>ตรวจสอบสถานะทุกรายการได้ที่หน้ารายการที่แจ้ง — รอดำเนินการ / กำลังดำเนินการ / แก้ไขแล้ว พร้อมเวลาอัปเดตล่าสุด</p>
    </div>
    <div class="feature-card">
      <div class="icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </div>
      <h3>แจ้งเตือนเหตุเร่งด่วนทันที</h3>
      <p>เหตุระดับสูงและวิกฤตจะถูกแจ้งเตือนทางอีเมลไปยังทีมเฝ้าระวังทันที เพื่อการตอบสนองอย่างรวดเร็ว</p>
    </div>
  </div>

  <div class="card" style="text-align:center">
    <h2>พบปัญหาไซเบอร์?</h2>
    <p class="sub">ใช้เวลาแจ้งเพียงไม่กี่นาที ระบบจะออกรหัสติดตามให้ทันที ช่วยให้ทีมความปลอดภัยดำเนินการได้อย่างรวดเร็ว</p>
    <div style="display:flex;gap:0.7rem;justify-content:center;flex-wrap:wrap">
      <a href="/report" class="btn btn-primary">เริ่มแจ้งปัญหา</a>
      <a href="/about" class="btn btn-ghost">ช่องทางติดต่ออื่นๆ</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
